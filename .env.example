SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DB_PASSWORD=
JWT_SECRET=
MAIL_PASSWORD=
LOCATIONIQ_API_KEY=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GEMINI_API_KEY=

# ── Mercado Pago (Prompt 5) ─────────────────────────────────────────
# Deixe BILLING_ENABLED=false ate ter as credenciais do seu app sandbox.
# Sandbox: pegue Access Token e Public Key em
# mercadopago.com.br/developers > Suas integracoes > (app) > Credenciais de teste
# (ambos comecam com TEST-). O webhook e configurado em "Webhooks" do mesmo painel.
BILLING_ENABLED=false
# BILLING_SIMULATE=true exercita todo o fluxo (cobranca, bloqueio, webhook,
# desbloqueio) SEM Mercado Pago -- util pra demo/teste sem credenciais.
BILLING_SIMULATE=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

# ── eNotas (NFS-e, Prompt 6) ───────────────────────────────────────
# NFSE_SIMULATE=true demonstra a emissao sem eNotas. Para valer de verdade:
# painel eNotas (homologacao) -> cadastre a empresa emitente do Nexus -> pegue
# a API key e o "empresaId". A API key vai aqui; o empresaId + descricao padrao
# do servico ficam em /admin/fiscal-config.
NFSE_SIMULATE=false
ENOTAS_API_KEY=
